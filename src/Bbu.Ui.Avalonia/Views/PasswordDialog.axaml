<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Bbu.Ui.Avalonia.Views"
             xmlns:t="clr-namespace:Bbu.Core.Texts;assembly=Bbu.Core"
             x:Class="Bbu.Ui.Avalonia.Views.PasswordDialog"
             FontFamily="{DynamicResource Sans}"
             FontSize="{DynamicResource FsBody}"
             Foreground="{DynamicResource Text}">

  <!-- 窗口内模态：外层的 Border.modal 与遮罩由 MainWindow 的 PwHost 承载，这里只放内容。
       它不再是一个独立 Window —— 独立窗口会进任务栏，也会脱离主窗口的层叠顺序。 -->
  <Grid RowDefinitions="Auto,Auto,Auto">

    <!-- ══ 标题行 ══ -->
    <Border Grid.Row="0" Padding="16,12"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0" Text="{x:Static t:Ui.AskTitle}"
                   FontSize="{DynamicResource FsTitle}" FontWeight="SemiBold"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1" Name="BtnClose" Classes="bb iconbtn"
                AutomationProperties.Name="{x:Static t:Ui.Close}"
                ToolTip.Tip="{x:Static t:Ui.Close}">
          <Path Classes="ic lucide" Data="{x:Static v:Icons.Close}"
                Stroke="{Binding $parent[Button].Foreground}"/>
        </Button>
      </Grid>
    </Border>

    <!-- ══ 正文：包 / 已尝试 / 为什么问 / 输入 ══ -->
    <StackPanel Grid.Row="1" Spacing="8" Margin="16,12">
      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="{x:Static t:Ui.AskArchiveLabel}" Margin="0,0,4,0"
                   Foreground="{DynamicResource Dim}" VerticalAlignment="Top"/>
        <!-- 完整路径，折行显示。同名包很常见，截掉开头等于把盘符与父目录丢了 -->
        <TextBlock Grid.Column="1" Name="TxtArchive" Foreground="{DynamicResource Dim}"
                   TextWrapping="Wrap" VerticalAlignment="Center"/>
      </Grid>

      <Grid ColumnDefinitions="Auto,*">
        <TextBlock Grid.Column="0" Text="{x:Static t:Ui.AskTriedLabel}" Margin="0,0,4,0"
                   Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Name="TxtTried" FontSize="{DynamicResource FsSmall}"
                   Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
      </Grid>

      <TextBlock Name="TxtSummary" TextWrapping="Wrap" LineHeight="20"
                 FontSize="{DynamicResource FsSmall}" Foreground="{DynamicResource Dim}"/>

      <TextBlock Name="TxtWrong" Text="{x:Static t:Ui.AskWrongPassword}" IsVisible="False"
                 FontSize="{DynamicResource FsSmall}" Foreground="{DynamicResource Warn}"/>

      <TextBox Name="TxtInput" Watermark="{x:Static t:Ui.AskInputPlaceholder}"
               Height="{DynamicResource HInput}"/>

      <TextBlock Text="{x:Static t:Ui.AskRememberNote}"
                 Foreground="{DynamicResource Faint}"/>
    </StackPanel>

    <!-- ══ 页脚：左验证（主操作），右跳过 ══ -->
    <Border Grid.Row="2" Padding="16,12"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0" Name="BtnVerify" Classes="bb btn primary"
                Content="{x:Static t:Ui.AskVerify}"/>
        <Button Grid.Column="2" Name="BtnSkip" Classes="bb btn"
                Content="{x:Static t:Ui.AskSkip}"/>
      </Grid>
    </Border>

  </Grid>
</UserControl>
